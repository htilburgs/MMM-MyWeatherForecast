.myweather-wrapper {
    font-family: 'Arial', sans-serif;
    color: #fff;
}

/* Current Weather */
.current-weather {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(255,255,255,0.2);
}

.current-icon {
    width: 80px;
    height: 80px;
}

.current-details {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.current-temp {
    font-size: 2.2em;
    font-weight: bold;
}

.current-condition {
    font-size: 1.2em;
}

.sun-times {
    font-size: 0.9em;
    color: rgba(255,255,255,0.7);
}

/* Forecast Bar */
.forecast-bar {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
    gap: 15px;
}

.forecast-day {
    text-align: center;
    background: rgba(255,255,255,0.1);
    padding: 8px;
    border-radius: 10px;
    width: 70px;
}

.forecast-day-name {
    font-weight: bold;
    margin-bottom: 5px;
}

.forecast-icon {
    width: 50px;
    height: 50px;
    margin-bottom: 5px;
}

.forecast-temp {
    font-size: 0.9em;
}
